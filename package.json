{
  "name": "abilitybench",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-aware incremental execution for deterministic developer workflows.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check . && tsc -p tsconfig.build.json && tsc -p tsconfig.json --noEmit && vitest run",
    "example:release-readiness": "pnpm build && node examples/release-readiness/run.ts",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
